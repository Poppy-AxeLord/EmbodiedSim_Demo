<mujoco model="shadow hand in-hand manipulation scene">
  <include file="left_hand.xml"/>

  <statistic extent="0.55"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="118" elevation="-18" offwidth="1280" offheight="800"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="metal" rgba="0.55 0.57 0.62 1" specular="0.6" shininess="0.4"/>
  </asset>

  <worldbody>
    <light pos="0.3 0.2 1.2" dir="0 0 -1" directional="true"/>
    <light pos="0.3 -0.5 0.8" dir="0 0.6 -1"/>

    <!-- 地面 -->
    <geom name="floor" pos="0 0 -0.30" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 腕部支撑台（纯视觉道具，不与手/球碰撞）—— 让"固定在工位上"看起来是合理的 -->
    <geom name="post" type="box" size="0.028 0.028 0.135" pos="0.105 0 -0.045"
          material="metal" contype="0" conaffinity="0"/>
    <geom name="post_base" type="box" size="0.075 0.075 0.010" pos="0.105 0 -0.175"
          material="metal" contype="0" conaffinity="0"/>
    <geom name="cradle" type="box" size="0.055 0.034 0.008" pos="0.105 0 -0.008"
          material="metal" contype="0" conaffinity="0"/>

    <!-- 接料盘（四壁方盘，释放后球落这里；参与碰撞） -->
    <body name="tray" pos="0.47 0.0 -0.150">
      <geom name="tray_base" type="box" size="0.105 0.105 0.006" pos="0 0 0"
            material="metal" contype="1" conaffinity="1" friction="1.0 0.05 0.002"/>
      <geom name="tray_wx1" type="box" size="0.005 0.105 0.026" pos="0.105 0 0.026"
            rgba="0.42 0.44 0.50 1" contype="1" conaffinity="1"/>
      <geom name="tray_wx0" type="box" size="0.005 0.105 0.026" pos="-0.105 0 0.026"
            rgba="0.42 0.44 0.50 1" contype="1" conaffinity="1"/>
      <geom name="tray_wy1" type="box" size="0.105 0.005 0.026" pos="0 0.105 0.026"
            rgba="0.42 0.44 0.50 1" contype="1" conaffinity="1"/>
      <geom name="tray_wy0" type="box" size="0.105 0.005 0.026" pos="0 -0.105 0.026"
            rgba="0.42 0.44 0.50 1" contype="1" conaffinity="1"/>
    </body>

    <!-- 掌心内的球（自由关节；位置由主程序写入）
         三个彩色标记球只作视觉用（不参与碰撞、质量可忽略），
         否则"球在掌心自转"肉眼完全看不出来。 -->
    <body name="ball" pos="0.335 0.005 0.35">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.04"
            rgba="0.13 0.34 0.85 1" condim="6"
            friction="1.2 0.03 0.002" mass="0.06" solref="0.01 1" solimp="0.9 0.95 0.001"/>
      <geom name="mk_yellow" type="sphere" size="0.013" pos="0.035 0 0"
            rgba="0.97 0.80 0.05 1" mass="0.0001" contype="0" conaffinity="0" group="2"/>
      <geom name="mk_red" type="sphere" size="0.013" pos="0 0.035 0"
            rgba="0.92 0.16 0.13 1" mass="0.0001" contype="0" conaffinity="0" group="2"/>
      <geom name="mk_green" type="sphere" size="0.013" pos="0 0 0.035"
            rgba="0.16 0.82 0.32 1" mass="0.0001" contype="0" conaffinity="0" group="2"/>
      <geom name="mk_white" type="sphere" size="0.013" pos="0 0 -0.035"
            rgba="0.95 0.95 0.95 1" mass="0.0001" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>
</mujoco>
